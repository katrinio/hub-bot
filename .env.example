# The Hub Bot — Environment Configuration

# Telegram bot token from @BotFather
# https://core.telegram.org/bots#6-botfather
TELEGRAM_BOT_TOKEN=

# Shared secret for authenticating Postbox handoff
# Must match HUB_AUTH_SECRET in Postbox deployment
# Generate with: openssl rand -hex 32
HUB_AUTH_SECRET=

# Postbox application URL
# Used to generate auth URLs for users
POSTBOX_URL=https://postbox.finpipe.net

# Hub administrator Telegram ID for feedback collection
# Used to send user feedback messages
# Get your ID: https://t.me/userinfobot
HUB_ADMIN_TELEGRAM_ID=
